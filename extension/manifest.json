{
  "manifest_version": 3,
  "name": "Confession Hover — Instant Confession & Creed Previews",
  "short_name": "Confession Hover",
  "version": "1.0.0",
  "description": "Instant 0ms hover previews for historic Christian confessions, catechisms & creeds — fully offline with 1-click community packs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Confession Hover Settings"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/confession-schema.js",
        "shared/confession-registry.js",
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "welcome/*",
        "test-page.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
